# Copy to backend/.env and replace every secret/placeholder.
ENVIRONMENT=development
APP_TIMEZONE=Asia/Kolkata

# Interakt / WhatsApp
INTERAKT_API_KEY=
INTERAKT_WEBHOOK_SECRET=
INTERAKT_BASE_URL=https://api.interakt.ai/v1/public
ADMIN_COUNTRY_CODE=+91
ADMIN_PHONE_NUMBER=
ADMIN_SESSION_WINDOW_HOURS=24

# Authentication
JWT_SECRET_KEY=replace_with_a_long_random_secret
CORS_ORIGINS=http://localhost:5173

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=attendance_agent
MONGODB_TLS=false

# Optional SQL Server backend (MongoDB remains the default).
# Keep DB_BACKEND=mongodb in any .env shared with the Docker deployment.
# For local-only tests, override DB_BACKEND in that process's environment.
# Use DB_BACKEND=mssql only after creating this project-specific empty database.
# Startup creates tables and indexes only inside MSSQL_DATABASE; it never creates
# or connects to master/another database. On Windows, ODBC Driver 18 and
# integrated authentication are used by default (no SQL credentials required).
DB_BACKEND=mongodb
MSSQL_SERVER=localhost
MSSQL_DATABASE=attendance_agent_local
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_TRUSTED_CONNECTION=true
# Optional SQL authentication for deployments that cannot use integrated auth.
# Keep real values only in an untracked local secret store/environment.
MSSQL_USERNAME=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Redis Streams
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_MAXLEN=100000
WORKER_CONSUMER_NAME=attendance-worker-1
NOTIFICATION_CONSUMER_NAME=notification-worker-1
WORKER_BATCH_SIZE=5
WORKER_BLOCK_MS=5000
WORKER_MAX_RETRIES=5
WORKER_RETRY_DELAY_SECONDS=2
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_DELAY_SECONDS=3

# OCR
# Example Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Duplicate / reuse detection
DUPLICATE_HASH_HAMMING_THRESHOLD=6
NORMALIZED_DUPLICATE_HASH_HAMMING_THRESHOLD=8

# Passive image-quality/liveness risk guard
LIVENESS_ENABLED=true
LIVENESS_MIN_FACE_RATIO=0.08
LIVENESS_MIN_SHARPNESS=35
