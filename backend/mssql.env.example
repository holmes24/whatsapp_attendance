# Copy to .env.mssql and replace these placeholders using the deployment server's settings.
DB_BACKEND=mssql
MSSQL_SERVER=sql-server.example.internal
MSSQL_DATABASE=attendance_agent
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_TRUSTED_CONNECTION=false
MSSQL_USERNAME=attendance_app
MSSQL_PASSWORD=replace-with-a-strong-random-password
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false
